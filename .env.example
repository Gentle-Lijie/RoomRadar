# 复制为 .env 后按需修改；.env 不会提交到仓库。

# ---- 主机 ----
# 前端（静态站点）的公开访问地址
FRONTEND_HOST=http://127.0.0.1:8080
# 后端 API 的公开访问地址；部署时注入前端构建（VITE_API_BASE），
# 前后端同域反代时可留空让前端走相对路径 /api。
BACKEND_HOST=http://127.0.0.1:3001

# ---- 端口 ----
# 后端 API 监听端口
API_PORT=3001
# 前端静态站点监听端口（pm2 serve）
WEB_PORT=8080

# ---- 进程 ----
# pm2 进程名前缀
PM2_APP_NAME=unnc-room-check
