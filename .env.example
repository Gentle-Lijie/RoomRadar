# 复制为 .env 后按需修改；.env 不会提交到仓库。

# ---- 端口 ----
# 唯一监听端口：API 与前端静态资源同端口（前端走同源 /api）
PORT=3001

# ---- 可选 ----
# Scientia / 会议室系统源站地址
# SCIENTIA_BASE_URL=http://timetablingunnc.nottingham.ac.uk:8017
# MRB_BASE_URL=https://meetingroombooking.nottingham.edu.cn
# SSO_BASE_URL=https://sso.nottingham.edu.cn

# pm2 进程名
PM2_APP_NAME=unnc-room-check
